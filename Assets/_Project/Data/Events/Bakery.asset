  m_Script: {fileID: 11500000, guid: 58e01966adce41742ae92e8763d6e968, type: 3}
  m_Name: Bakery
  m_EditorClassIdentifier: Assembly-CSharp::NightTrolleybus.Narrative.RoadEventData
  title: "\u041F\u0435\u043A\u0430\u0440\u043D\u044F"
  description: "\u0406\u0437 \u0432\u0456\u043A\u043D\u0430 \u043F\u0435\u043A\u0430\u0440\u043D\u0456 \u0449\u0435 \u0439\u0434\u0435 \u0442\u0435\u043F\u043B\u043E, \u0445\u043E\u0447 \u0443 \u043D\u0456\u0439 \u0434\u0430\u0432\u043D\u043E \u043D\u0456\u043A\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454."
  choices:
  - text: "\u041F\u043E\u0441\u0442\u043E\u044F\u0442\u0438 \u0431\u0456\u043B\u044F \u0441\u0442\u0456\u043D\u0438"
    outcome: "\u0422\u0435\u043F\u043B\u0430 \u0441\u0442\u0456\u043D\u0430 \u0439 \u0437\u0430\u043F\u0430\u0445 \u0445\u043B\u0456\u0431\u0430. \u041D\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u0445\u0432\u0438\u043B\u0438\u043D \u0443\u0441\u0435 \u043C\u0430\u0439\u0436\u0435 \u0434\u043E\u0431\u0440\u0435."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 0}
    flameChange: 0
    temperatureChange: 25
    powerChange: 0
  - text: "\u041F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456"
    outcome: "\u0423 \u0448\u0430\u0444\u0456 \u0437\u043D\u0430\u0439\u0448\u043B\u0430\u0441\u044F \u0441\u0432\u0456\u0447\u043A\u0430. \u041F\u043E\u043A\u0438 \u0448\u0443\u043A\u0430\u043B\u0438, \u0412\u043E\u0433\u043D\u0438\u043A \u0447\u0435\u043A\u0430\u0432 \u0441\u0430\u043C \u0456 \u0442\u0440\u043E\u0445\u0438 \u0437\u0433\u0430\u0441."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 11400000, guid: e3a82adcf157b144db6a299ec27c9926, type: 2}
    flameChange: -4
    temperatureChange: 0
    powerChange: 0
