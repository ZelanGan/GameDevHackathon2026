  m_Name: Child
  m_EditorClassIdentifier: Assembly-CSharp::NightTrolleybus.Narrative.RoadEventData
  title: "\u0414\u0438\u0442\u0438\u043D\u0430 \u0431\u0435\u0437 \u0442\u0456\u043D\u0456"
  description: "\u041F\u043E\u0441\u0435\u0440\u0435\u0434 \u0434\u043E\u0440\u043E\u0433\u0438 \u0441\u0442\u043E\u0457\u0442\u044C \u0434\u0438\u0442\u0438\u043D\u0430. \u0421\u0432\u0456\u0442\u043B\u043E \u0444\u0430\u0440 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u043A\u0440\u0456\u0437\u044C \u043D\u0435\u0457, \u0456 \u0442\u0456\u043D\u0456 \u043D\u0435\u043C\u0430\u0454."
  choices:
  - text: "\u0417\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F \u0439 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456"
    outcome: "\u0423 \u0441\u0430\u043B\u043E\u043D \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0445\u043E\u043B\u043E\u0434, \u0430 \u0434\u0438\u0442\u0438\u043D\u0438 \u043D\u0435\u043C\u0430\u0454. \u041D\u0430 \u0441\u0438\u0434\u0456\u043D\u043D\u0456 \u043B\u0435\u0436\u0438\u0442\u044C \u0441\u0432\u0456\u0447\u043A\u0430."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 11400000, guid: e3a82adcf157b144db6a299ec27c9926, type: 2}
    flameChange: 0
    temperatureChange: -15
    powerChange: 0
  - text: "\u041D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B \u0456 \u0457\u0445\u0430\u0442\u0438"
    outcome: "\u0414\u0438\u0442\u0438\u043D\u0430 \u043D\u0435 \u0437\u0440\u0443\u0448\u0438\u043B\u0430 \u0437 \u043C\u0456\u0441\u0446\u044F. \u0412\u0438 \u043F\u0440\u043E\u0457\u0445\u0430\u043B\u0438 \u043A\u0440\u0456\u0437\u044C \u043D\u0435\u0457. \u0412\u043E\u0433\u043D\u0438\u043A \u043D\u0435 \u043A\u0430\u0436\u0435 \u043D\u0456 \u0441\u043B\u043E\u0432\u0430."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 0}
    flameChange: -6
    temperatureChange: 0
    powerChange: 0
