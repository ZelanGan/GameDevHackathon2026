  m_Name: Conductor
  m_EditorClassIdentifier: Assembly-CSharp::NightTrolleybus.Narrative.RoadEventData
  title: "\u0421\u0442\u0430\u0440\u0430 \u043A\u043E\u043D\u0434\u0443\u043A\u0442\u043E\u0440\u043A\u0430"
  description: "\u041D\u0430 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0439 \u0437\u0443\u043F\u0438\u043D\u0446\u0456 \u0441\u0442\u043E\u0457\u0442\u044C \u043A\u043E\u043D\u0434\u0443\u043A\u0442\u043E\u0440\u043A\u0430 \u0432 \u0444\u043E\u0440\u043C\u0456 \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043A\u0440\u0438\u0442\u043E\u0433\u043E \u0434\u0435\u043F\u043E. \u0412\u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u0430\u0454 \u0440\u0443\u043A\u0443: \xAB\u0412\u0430\u0448 \u043A\u0432\u0438\u0442\u043E\u043A?\xBB"
  choices:
  - text: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u043A\u0432\u0438\u0442\u043E\u043A"
    outcome: "\u0412\u043E\u043D\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0454 \u043A\u0432\u0438\u0442\u043E\u043A \u0456 \u043C\u043E\u0432\u0447\u043A\u0438 \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0431\u0456\u043B\u044F \u0434\u0432\u0435\u0440\u0435\u0439 \u0430\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440."
    requiredItem: {fileID: 11400000, guid: 731e7bb6a43be5048a07b42c544781bd, type: 2}
    rewardItem: {fileID: 11400000, guid: 81b55968d56aa434ea7fa1abc7ae1123, type: 2}
    flameChange: 0
    temperatureChange: 0
    powerChange: 0
  - text: "\u041F\u0440\u043E\u0457\u0445\u0430\u0442\u0438 \u043F\u043E\u0432\u0437"
    outcome: "\u0407\u0457 \u043F\u043E\u0433\u043B\u044F\u0434 \u043F\u0440\u043E\u0432\u043E\u0434\u0436\u0430\u0454 \u0432\u0430\u0441 \u0434\u043E\u0432\u0433\u043E. \u0412\u043E\u0433\u043D\u0438\u043A \u0447\u043E\u043C\u0443\u0441\u044C \u0437\u0456\u0449\u0443\u043B\u044E\u0454\u0442\u044C\u0441\u044F."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 0}
