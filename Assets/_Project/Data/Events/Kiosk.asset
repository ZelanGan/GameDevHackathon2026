  m_Name: Kiosk
  m_EditorClassIdentifier: Assembly-CSharp::NightTrolleybus.Narrative.RoadEventData
  title: "\u041A\u0456\u043E\u0441\u043A \xAB\u041F\u0440\u0435\u0441\u0430\xBB"
  description: "\u041A\u0456\u043E\u0441\u043A \u0432\u0456\u0434\u0447\u0438\u043D\u0435\u043D\u0438\u0439, \u0430 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u043D\u0456\u043A\u043E\u0433\u043E. \u041D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0443 \u0441\u0456\u0440\u043D\u0438\u043A\u0438, \u043F\u043E\u0440\u0443\u0447 \u043F\u0430\u0447\u043A\u0430 \u0441\u0442\u0430\u0440\u0438\u0445 \u043A\u0432\u0438\u0442\u043A\u0456\u0432."
  choices:
  - text: "\u0412\u0437\u044F\u0442\u0438 \u0441\u0456\u0440\u043D\u0438\u043A\u0438"
    outcome: "\u0421\u0456\u0440\u043D\u0438\u043A\u0438 \u0441\u0443\u0445\u0456. \u0426\u0435 \u0432\u0436\u0435 \u0443\u0434\u0430\u0447\u0430."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 11400000, guid: c0eaf6ba539542a49ae4c583b5237063, type: 2}
    flameChange: 0
    temperatureChange: 0
    powerChange: 0
  - text: "\u0412\u0437\u044F\u0442\u0438 \u043A\u0432\u0438\u0442\u043A\u0438"
    outcome: "\u041A\u0430\u0436\u0443\u0442\u044C, \u043D\u0438\u043C\u0438 \u0449\u0435 \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u0432\u0430\u0442\u0438\u0441\u044F. \u0425\u0442\u043E\u0441\u044C \u0434\u043E\u0441\u0456 \u0457\u0445 \u043F\u0440\u0438\u0439\u043C\u0430\u0454."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 11400000, guid: 731e7bb6a43be5048a07b42c544781bd, type: 2}
