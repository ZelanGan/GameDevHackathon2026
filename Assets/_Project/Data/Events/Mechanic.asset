  m_Script: {fileID: 11500000, guid: 58e01966adce41742ae92e8763d6e968, type: 3}
  m_Name: Mechanic
  m_EditorClassIdentifier: Assembly-CSharp::NightTrolleybus.Narrative.RoadEventData
  title: "\u041C\u0435\u0445\u0430\u043D\u0456\u043A \u0456\u0437 \u043B\u0456\u0445\u0442\u0430\u0440\u0438\u043A\u043E\u043C"
  description: "\u041D\u0430 \u0443\u0437\u0431\u0456\u0447\u0447\u0456 \u043C\u0435\u0445\u0430\u043D\u0456\u043A \u043C\u0430\u0445\u0430\u0454 \u0437\u0433\u0430\u0441\u043B\u0438\u043C \u043B\u0456\u0445\u0442\u0430\u0440\u0438\u043A\u043E\u043C: \xAB\u041F\u043E\u0434\u0456\u043B\u0456\u0442\u044C\u0441\u044F \u0432\u043E\u0433\u043D\u0435\u043C, \u0430 \u044F \u043F\u0456\u0434\u043A\u0440\u0443\u0447\u0443 \u0432\u0430\u043C \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0438\xBB."
  choices:
  - text: "\u0412\u0456\u0434\u0434\u0430\u0442\u0438 \u0441\u0456\u0440\u043D\u0438\u043A"
    outcome: "\u041C\u0435\u0445\u0430\u043D\u0456\u043A \u0449\u0430\u0441\u043B\u0438\u0432\u0438\u0439. \u0422\u0440\u043E\u043B\u0435\u0439\u0431\u0443\u0441 \u0433\u0443\u0434\u0435 \u0431\u0430\u0434\u044C\u043E\u0440\u0456\u0448\u0435."
    requiredItem: {fileID: 11400000, guid: c0eaf6ba539542a49ae4c583b5237063, type: 2}
    rewardItem: {fileID: 0}
    flameChange: 0
    temperatureChange: 0
    powerChange: 20
  - text: "\u0414\u0430\u0442\u0438 \u0412\u043E\u0433\u043D\u0438\u043A\u0443 \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F"
    outcome: "\u0412\u043E\u0433\u043D\u0438\u043A \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u0430\u0454 \u0456\u0441\u043A\u0440\u0443. \u0419\u043E\u043C\u0443 \u0432\u0430\u0436\u043A\u043E, \u0430\u043B\u0435 \u043C\u0435\u0445\u0430\u043D\u0456\u043A \u043D\u0435 \u043E\u0431\u043C\u0430\u043D\u044E\u0454."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 0}
    flameChange: -10
    temperatureChange: 0
    powerChange: 30
  - text: "\u0407\u0445\u0430\u0442\u0438 \u0434\u0430\u043B\u0456"
    outcome: "\u041B\u0456\u0445\u0442\u0430\u0440\u0438\u043A \u0449\u0435 \u0434\u043E\u0432\u0433\u043E \u0431\u043B\u0438\u043C\u0430\u0454 \u0432 \u0434\u0437\u0435\u0440\u043A\u0430\u043B\u0456, \u043F\u043E\u043A\u0438 \u043D\u0435 \u0437\u043D\u0438\u043A\u0430\u0454."
    requiredItem: {fileID: 0}
    rewardItem: {fileID: 0}
    flameChange: 0
    temperatureChange: 0
    powerChange: 0
